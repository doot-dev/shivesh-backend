# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3001

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=debug
ENABLE_FILE_LOGGING=false

# Database Configuration
# DATABASE_URL=your_database_connection_string_here

# Authentication
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRES_IN=24h

# External APIs
# API_KEY=your_api_key_here
# EXTERNAL_SERVICE_URL=https://api.example.com

# MSG91 OTP (SMS)
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Redis Configuration (if using Redis)
# REDIS_URL=redis://localhost:6379

# MSG91 OTP (SMS)
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_TEMPLATE_ID=your_msg91_template_id_here

# AWS Configuration (if using AWS services)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_bucket_name
# Invoice PDF seller block (shown on every generated invoice)
# INVOICE_SELLER_NAME=Shivesh
# INVOICE_SELLER_ADDRESS=
# INVOICE_SELLER_GSTIN=

# MinIO object storage for /uploads. Put the real values in .env.local (git-ignored), not here.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=shivesh-uploads

# Server time zone for dates, bills and financial years (also set in ecosystem.config.cjs)
TZ=Asia/Kolkata

# Seller block on the invoice PDF: legal name, address and GSTIN exactly as on the GST registration
INVOICE_SELLER_NAME=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=

# D16: clients must be KYC-verified to log in. Set to false only for a demo, before the office has verified existing clients.
CLIENT_LOGIN_REQUIRES_KYC=true

# Days after the delivery date that an order, its trucks and challans can still be edited (W37)
ORDER_UPDATE_WINDOW_DAYS=30

# P1.9: require a signed-in token for /uploads (KYC = panel only). Turn on after the panel and apps send the token.
UPLOADS_REQUIRE_AUTH=false
