// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// USER MANAGEMENT MODELS
// ========================================

model User {
  id             Int               @id @default(autoincrement())
  name           String
  employeeId     String
  userName       String
  password       String
  role           UserRole
  status         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  isDeleted      Boolean           @default(false)
  lastLoginAt    DateTime?
  phone          String? // For field tech OTP login
  menuAccess     Json              @default("[]")
  assignedLeads  Lead[]            @relation("LeadAssignedTo")
  activities     Activity[]        @relation("UserActivities")
  assignedOrders OrderTechnician[] @relation("OrderTechnicianUser")
}

model OTP {
  id        Int      @id @default(autoincrement())
  mode      MODE
  finder    String
  otp       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  size           Size[]
  isActive       Boolean          @default(true)
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  VendorLocation VendorLocation[]
}

model Size {
  id          Int      @id @default(autoincrement())
  name        String
  subcategory String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
}

model Vendor {
  id                    Int                    @id @default(autoincrement())
  companyName           String
  ownerName             String
  phone                 String
  email                 String?
  address               String                 @db.Text
  gstNumber             String?                @unique
  panNumber             String?                @unique
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isDeleted             Boolean                @default(false)
  locations             VendorLocation[]
  projectProductVendors ProjectProductVendor[]
  orderVendors          OrderVendor[]
}

model VendorLocation {
  id           Int             @id @default(autoincrement())
  vendorId     Int
  plantName    String          @db.VarChar(255)
  latitude     String          @db.Text
  longitude    String          @db.Text
  address      String          @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isDeleted    Boolean         @default(false)
  Vendor       Vendor          @relation(fields: [vendorId], references: [id])
  handlers     VendorHandler[]
  product      Product?        @relation(fields: [productId], references: [id])
  productId    Int?
  orderVendors OrderVendor[]
}

model VendorHandler {
  id               Int             @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)
  VendorLocation   VendorLocation? @relation(fields: [vendorLocationId], references: [id])
  vendorLocationId Int?
  orderVendors     OrderVendor[]
}

model Lead {
  id            String     @id @default(cuid())
  companyName   String
  contactPerson String
  email         String?
  phone         String?
  address       String?
  date          DateTime?
  time          String?
  title         String?
  description   String?    @db.Text
  requirement   String?    @db.Text
  source        Source     @default(REFERRAL)
  status        LeadStatus @default(NEW)
  assignedToId  Int?
  assignedTo    User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Activity {
  id          String         @id @default(cuid())
  title       String?
  description String?
  entityType  EntityType
  entityId    String // e.g. Lead ID, Post ID, etc.
  action      ActivityAction
  createdById Int
  createdBy   User           @relation("UserActivities", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([entityType, entityId])
}

// ========================================
// CLIENT MANAGEMENT MODELS
// ========================================

model Client {
  id            String        @id @default(cuid())
  clientId      String        @unique // e.g. CL-2025-0001
  companyName   String
  ownerName     String
  contactNumber String
  email         String        @unique
  hasGST        Boolean       @default(false)
  gstNumber     String?       @unique
  ownerPan      String?
  ownerAadhaar  String?
  address       String        @db.Text
  status        ClientStatus  @default(ACTIVE)
  kycStatus     KYCStatus     @default(PENDING)
  kycDocuments  KYCDocument[]
  projects      Project[]
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isDeleted     Boolean       @default(false)
}

model KYCDocument {
  id         String   @id @default(cuid())
  docId      String   @unique // e.g. DOC-001
  fileName   String
  fileUrl    String
  type       String // passport, driver-license, utility-bill, gst, pan, etc.
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
}

// ─── FCM device tokens (CLIENT + FIELD_TECH, multi-device) ───────────────────

model DeviceToken {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String // android | ios
  targetType String // CLIENT | FIELD_TECH
  targetId   String // client.id or user.id (as string)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId])
}

// ========================================
// PROJECT MANAGEMENT MODELS
// ========================================

model Project {
  id              String        @id @default(cuid())
  projectId       String        @unique // e.g. P-2025-0001
  projectName     String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  siteName        String
  projectLocation String        @db.Text
  latitude        Float?
  longitude       Float?
  address         String?       @db.Text
  projectManager  String?
  status          ProjectStatus @default(ACTIVE)

  // Commission details
  commissionPersonName   String?
  commissionAmountPerM3  Float?
  commissionPersonMobile String?

  // Credit details
  creditAmount          Float?
  creditResetPeriodDays Int?

  projectProducts ProjectProduct[]
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)

  @@index([clientId])
}

model TempProject {
  id              String  @id @default(cuid())
  tempProjectId   String  @unique // e.g. TMP-1001
  projectName     String?
  clientId        String?
  siteName        String?
  projectLocation String? @db.Text

  // Commission details
  commissionPersonName    String?
  commissionAmountPerM3   Float?
  commissionIncludeInCost Boolean @default(false)

  // Credit details
  creditAmount          Float?
  creditResetPeriodDays Int?

  // Products stored as JSON temporarily
  productsData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Auto-expire after 24 hours
}

model ProjectProduct {
  id           String                 @id @default(cuid())
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productName  String
  productGrade String
  costPrice    Float
  vendors      ProjectProductVendor[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([projectId])
}

model ProjectProductVendor {
  id               String         @id @default(cuid())
  projectProductId String
  projectProduct   ProjectProduct @relation(fields: [projectProductId], references: [id], onDelete: Cascade)
  vendorId         Int
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  customPrice      Float
  priority         VendorPriority
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectProductId])
  @@index([vendorId])
}

// ========================================
// ORDER MANAGEMENT MODELS
// ========================================

model Order {
  id              String            @id @default(cuid())
  orderId         String            @unique // e.g. ORD-2025-0001
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id])
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  productName     String
  productGrade    String
  quantity        String
  deliveryAddress String?           @db.Text
  date            String?
  time            String?
  status          OrderStatus       @default(NEW)
  deliveryStatus  DeliveryStatus    @default(ASSIGNED)
  vendors         OrderVendor[]
  technicians     OrderTechnician[]
  tmDetails       TmDetail[]
  comments        OrderComment[]
  notifications   Notification[]
  bill            Bill?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isDeleted       Boolean           @default(false)

  @@index([projectId])
  @@index([clientId])
}

// One bill per order. `quantity` and `amount` are snapshotted at generation
// time so an issued bill does not silently change when TMs are edited later.
model Bill {
  id        String     @id @default(cuid())
  billNo    String     @unique // e.g. BILL-2025-0001
  orderId   String     @unique
  order     Order      @relation(fields: [orderId], references: [id])
  quantity  Float // total accepted TM quantity at generation time
  rate      Float // per-unit rate applied
  amount    Float // quantity * rate
  status      BillStatus @default(PENDING)
  documentUrl String? // uploaded bill PDF/photo
  issueDate   DateTime?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDeleted Boolean    @default(false)

  @@index([orderId])
}

// An order may be sourced from several vendors; each row is one vendor
// assignment (vendor + the plant it ships from + the handler to contact).
model OrderVendor {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId         Int
  vendor           Vendor          @relation(fields: [vendorId], references: [id])
  vendorLocationId Int?
  vendorLocation   VendorLocation? @relation(fields: [vendorLocationId], references: [id])
  vendorHandlerId  Int?
  vendorHandler    VendorHandler?  @relation(fields: [vendorHandlerId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)

  @@index([orderId])
  @@index([vendorId])
}

// Field technicians assigned to an order. Replaces Order.assignedToId; the
// mobile tech app scopes every order query through this table.
model OrderTechnician {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("OrderTechnicianUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([orderId])
  @@index([userId])
}

model TmDetail {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tmNumber        String
  truckNo         String
  qty             String
  // Everything below the truck and its load is filled in as the TM runs, so a
  // TM can be planned on the order before any of it is known.
  dispatchTime    String?
  arrivalTime     String?
  batchStartTime  String?
  batchEndTime    String?
  challanNo       String?
  challanUrl      String? // uploaded challan PDF/photo
  // Where the truck is. Billing is driven by the order, not by TMs.
  status          DeliveryStatus @default(ASSIGNED)
  // Per-truck accept/reject shown on the bill detail page. Does not affect the
  // billed amount — a rejection is a record, not a deduction.
  approvalStatus  TmApproval     @default(PENDING)
  rejectionReason String?        @db.Text
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)

  @@index([orderId])
}

model OrderComment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message    String   @db.Text
  authorType String // ADMIN | CLIENT | FIELD_TECH
  authorId   String
  authorName String
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Notification {
  id         String   @id @default(cuid())
  targetType String // CLIENT | FIELD_TECH | ADMIN
  targetId   String // clientId (string) or userId (int as string)
  title      String
  message    String   @db.Text
  isRead     Boolean  @default(false)
  type       String // ORDER_CREATED | STATUS_UPDATED | COMMENT_ADDED | REMINDER | GENERAL
  relatedId  String? // orderId or other entity id
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([orderId])
}

// ========================================
// ENUMS
// ========================================
enum MODE {
  EMAIL
  SMS
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  ACCOUNTANT
  FIELD_TECHNICIAN
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum VendorPriority {
  HIGH
  MEDIUM
  LOW
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum TmApproval {
  PENDING
  ACCEPTED
  REJECTED
}

enum BillStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum Source {
  REFERRAL
  WEBSITE
  COLD_CALL
  ADVERTISEMENT
  SOCIAL_MEDIA
}

enum EntityType {
  LEAD
  POST
  PROJECT
  TASK
  USER
  CLIENT
  ORDER
}

enum ActivityAction {
  CREATED
  UPDATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  LOGGED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}
