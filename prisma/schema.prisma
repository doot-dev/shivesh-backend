generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int               @id @default(autoincrement())
  name           String
  employeeId     String
  userName       String
  password       String
  role           UserRole
  status         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lastLoginAt    DateTime?
  menuAccess     Json
  isDeleted      Boolean           @default(false)
  phone          String?
  activities     Activity[]        @relation("UserActivities")
  assignedLeads  Lead[]            @relation("LeadAssignedTo")
  assignedOrders OrderTechnician[] @relation("OrderTechnicianUser")
}

model OTP {
  id        Int      @id @default(autoincrement())
  mode      MODE
  finder    String
  otp       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  isActive       Boolean          @default(true)
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  size           Size[]
  VendorLocation VendorLocation[]
}

model Size {
  id        Int      @id @default(autoincrement())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int?
  Product   Product? @relation(fields: [productId], references: [id])

  @@index([productId], map: "Size_productId_fkey")
}

/// Standalone master list of sub-categories (e.g. "Pure OPC", "Pure Mix").
/// Deliberately NOT related to Size or ProjectProduct: consumers copy the
/// `name` string onto their own row, so renaming a master entry here never
/// rewrites history on existing project products.
model Subcategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id                    Int                    @id @default(autoincrement())
  companyName           String
  ownerName             String
  phone                 String
  email                 String?
  address               String                 @db.Text
  gstNumber             String?                @unique
  panNumber             String?                @unique
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isDeleted             Boolean                @default(false)
  orderVendors          OrderVendor[]
  projectProductVendors ProjectProductVendor[]
  locations             VendorLocation[]
}

model VendorLocation {
  id           Int             @id @default(autoincrement())
  vendorId     Int
  latitude     String          @db.Text
  longitude    String          @db.Text
  address      String          @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isDeleted    Boolean         @default(false)
  plantName    String          @db.VarChar(255)
  productId    Int?
  orderVendors OrderVendor[]
  handlers     VendorHandler[]
  product      Product?        @relation(fields: [productId], references: [id])
  Vendor       Vendor          @relation(fields: [vendorId], references: [id])

  @@index([productId], map: "VendorLocation_productId_fkey")
  @@index([vendorId], map: "VendorLocation_vendorId_fkey")
}

model VendorHandler {
  id               Int             @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)
  vendorLocationId Int?
  orderVendors     OrderVendor[]
  VendorLocation   VendorLocation? @relation(fields: [vendorLocationId], references: [id])

  @@index([vendorLocationId], map: "VendorHandler_vendorLocationId_fkey")
}

model Lead {
  id            String     @id @default(cuid())
  companyName   String
  contactPerson String
  email         String?
  phone         String?
  address       String?
  source        Source     @default(REFERRAL)
  status        LeadStatus @default(NEW)
  assignedToId  Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  requirement   String?    @db.Text
  date          DateTime?
  description   String?    @db.Text
  time          String?
  title         String?
  assignedTo    User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])

  @@index([assignedToId], map: "Lead_assignedToId_fkey")
}

model Activity {
  id          String         @id @default(cuid())
  title       String?
  description String?
  entityType  EntityType
  entityId    String
  action      ActivityAction
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation("UserActivities", fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@index([createdById], map: "Activity_createdById_fkey")
}

model Client {
  id            String        @id @default(cuid())
  clientId      String        @unique
  companyName   String
  ownerName     String
  contactNumber String
  email         String        @unique
  hasGST        Boolean       @default(false)
  gstNumber     String?       @unique
  ownerPan      String?
  ownerAadhaar  String?
  address       String        @db.Text
  status        ClientStatus  @default(ACTIVE)
  kycStatus     KYCStatus     @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isDeleted     Boolean       @default(false)
  kycDocuments  KYCDocument[]
  orders        Order[]
  projects      Project[]
}

model KYCDocument {
  id         String   @id @default(cuid())
  docId      String   @unique
  fileName   String
  fileUrl    String
  type       String
  clientId   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetType, targetId])
}

model Project {
  id                     String           @id @default(cuid())
  projectId              String           @unique
  projectName            String
  clientId               String
  siteName               String
  projectLocation        String           @db.Text
  projectManager         String?
  status                 ProjectStatus    @default(ACTIVE)
  commissionPersonName   String?
  commissionAmountPerM3  Float?
  creditAmount           Float?
  creditResetPeriodDays  Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  isDeleted              Boolean          @default(false)
  address                String?          @db.Text
  commissionPersonMobile String?
  latitude               Float?
  longitude              Float?
  orders                 Order[]
  client                 Client           @relation(fields: [clientId], references: [id])
  projectProducts        ProjectProduct[]

  @@index([clientId])
}

model TempProject {
  id                      String   @id @default(cuid())
  tempProjectId           String   @unique
  projectName             String?
  clientId                String?
  siteName                String?
  projectLocation         String?  @db.Text
  commissionPersonName    String?
  commissionAmountPerM3   Float?
  commissionIncludeInCost Boolean  @default(false)
  creditAmount            Float?
  creditResetPeriodDays   Int?
  productsData            Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  expiresAt               DateTime
}

model ProjectProduct {
  id           String                 @id @default(cuid())
  projectId    String
  productName  String
  productGrade String
  /// Copied by value from the Subcategory master at create/update time —
  /// intentionally a plain string, NOT a foreign key.
  subcategory  String                 @default("")
  costPrice    Float
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendors      ProjectProductVendor[]

  @@index([projectId])
}

model ProjectProductVendor {
  id               String         @id @default(cuid())
  projectProductId String
  vendorId         Int
  customPrice      Float
  priority         VendorPriority
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  projectProduct   ProjectProduct @relation(fields: [projectProductId], references: [id], onDelete: Cascade)
  vendor           Vendor         @relation(fields: [vendorId], references: [id])

  @@index([projectProductId])
  @@index([vendorId])
}

model Order {
  id              String            @id @default(cuid())
  orderId         String            @unique
  projectId       String
  clientId        String
  productName     String
  productGrade    String
  quantity        String
  deliveryAddress String?           @db.Text
  date            String?
  time            String?
  status          OrderStatus       @default(NEW)
  deliveryStatus  DeliveryStatus    @default(ASSIGNED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isDeleted       Boolean           @default(false)
  bill            Bill?
  notifications   Notification[]
  client          Client            @relation(fields: [clientId], references: [id])
  project         Project           @relation(fields: [projectId], references: [id])
  comments        OrderComment[]
  technicians     OrderTechnician[]
  vendors         OrderVendor[]
  tmDetails       TmDetail[]
  cubeTests       CubeTest[]

  @@index([projectId])
  @@index([clientId])
}

model CubeTest {
  id          String         @id @default(cuid())
  orderId     String
  castingDate DateTime
  quantity    String
  period      CubeTestPeriod
  fromDate    DateTime
  toDate      DateTime
  fileUrl     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isDeleted   Boolean        @default(false)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Bill {
  id          String     @id @default(cuid())
  billNo      String     @unique
  orderId     String     @unique
  quantity    Float
  rate        Float
  amount      Float
  status      BillStatus @default(PENDING)
  documentUrl String?
  issueDate   DateTime?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isDeleted   Boolean    @default(false)
  order       Order      @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderVendor {
  id               String          @id @default(cuid())
  orderId          String
  vendorId         Int
  vendorLocationId Int?
  vendorHandlerId  Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorHandler    VendorHandler?  @relation(fields: [vendorHandlerId], references: [id])
  vendor           Vendor          @relation(fields: [vendorId], references: [id])
  vendorLocation   VendorLocation? @relation(fields: [vendorLocationId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([vendorHandlerId], map: "OrderVendor_vendorHandlerId_fkey")
  @@index([vendorLocationId], map: "OrderVendor_vendorLocationId_fkey")
}

model OrderTechnician {
  id        String   @id @default(cuid())
  orderId   String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation("OrderTechnicianUser", fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
}

model TmDetail {
  id              String         @id @default(cuid())
  orderId         String
  tmNumber        String
  truckNo         String
  qty             String
  dispatchTime    String?
  arrivalTime     String?
  batchStartTime  String?
  batchEndTime    String?
  challanNo       String?
  challanUrl      String?
  status          DeliveryStatus @default(ASSIGNED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)
  approvalStatus  TmApproval     @default(PENDING)
  rejectionReason String?        @db.Text
  approvedAt      DateTime?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderComment {
  id         String   @id @default(cuid())
  orderId    String
  message    String   @db.Text
  authorType String
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Notification {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  title      String
  message    String   @db.Text
  isRead     Boolean  @default(false)
  type       String
  relatedId  String?
  orderId    String?
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([targetType, targetId])
  @@index([orderId])
}

enum MODE {
  EMAIL
  SMS
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  ACCOUNTANT
  FIELD_TECHNICIAN
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum VendorPriority {
  HIGH
  MEDIUM
  LOW
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum CubeTestPeriod {
  SEVEN_DAYS
  FOURTEEN_DAYS
  TWENTYONE_DAYS
  CUSTOM
}

enum TmApproval {
  PENDING
  ACCEPTED
  REJECTED
}

enum BillStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum Source {
  REFERRAL
  WEBSITE
  COLD_CALL
  ADVERTISEMENT
  SOCIAL_MEDIA
}

enum EntityType {
  LEAD
  POST
  PROJECT
  TASK
  USER
  CLIENT
  ORDER
}

enum ActivityAction {
  CREATED
  UPDATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  LOGGED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}
