// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// USER MANAGEMENT MODELS
// ========================================

model User {
  id            Int        @id @default(autoincrement())
  name          String
  employeeId    String
  userName      String
  password      String
  role          UserRole
  status        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isDeleted     Boolean    @default(false)
  lastLoginAt   DateTime?
  menuAccess    Json       @default("[]") // JSON array of accessible menu items
  assignedLeads Lead[]     @relation("LeadAssignedTo")
  activities    Activity[] @relation("UserActivities")
}

model OTP {
  id        Int      @id @default(autoincrement())
  mode      MODE
  finder    String
  otp       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  size           Size[]
  isActive       Boolean          @default(true)
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  VendorLocation VendorLocation[]
}

model Size {
  id          Int      @id @default(autoincrement())
  name        String
  subcategory String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Product     Product? @relation(fields: [productId], references: [id])
  productId   Int?
}

model Vendor {
  id          Int              @id @default(autoincrement())
  companyName String
  ownerName   String
  phone       String
  email       String?
  address     String           @db.Text
  gstNumber   String?          @unique
  panNumber   String?          @unique
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isDeleted   Boolean          @default(false)
  locations   VendorLocation[]
}

model VendorLocation {
  id        Int             @id @default(autoincrement())
  vendorId  Int
  plantName String          @db.VarChar(255)
  latitude  String          @db.Text
  longitude String          @db.Text
  address   String          @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  isDeleted Boolean         @default(false)
  Vendor    Vendor          @relation(fields: [vendorId], references: [id])
  handlers  VendorHandler[]
  product   Product?        @relation(fields: [productId], references: [id])
  productId Int?
}

model VendorHandler {
  id               Int             @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)
  VendorLocation   VendorLocation? @relation(fields: [vendorLocationId], references: [id])
  vendorLocationId Int?
}

model Lead {
  id            String     @id @default(cuid())
  companyName   String
  contactPerson String
  email         String?
  phone         String?
  address       String?
  date          DateTime?
  time          String?
  title         String?
  description   String?    @db.Text
  requirement   String?    @db.Text
  source        Source     @default(REFERRAL)
  status        LeadStatus @default(NEW)
  assignedToId  Int?
  assignedTo    User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Activity {
  id          String         @id @default(cuid())
  title       String?
  description String?
  entityType  EntityType
  entityId    String // e.g. Lead ID, Post ID, etc.
  action      ActivityAction
  createdById Int
  createdBy   User           @relation("UserActivities", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([entityType, entityId])
}

// ========================================
// CLIENT MANAGEMENT MODELS
// ========================================

model Client {
  id            String        @id @default(cuid())
  clientId      String        @unique // e.g. CL-2025-0001
  companyName   String
  ownerName     String
  contactNumber String
  email         String        @unique
  hasGST        Boolean       @default(false)
  gstNumber     String?       @unique
  ownerPan      String?
  ownerAadhaar  String?
  address       String        @db.Text
  status        ClientStatus  @default(ACTIVE)
  kycStatus     KYCStatus     @default(PENDING)
  kycDocuments  KYCDocument[]
  projects      Project[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isDeleted     Boolean       @default(false)
}

model KYCDocument {
  id         String   @id @default(cuid())
  docId      String   @unique // e.g. DOC-001
  fileName   String
  fileUrl    String
  type       String // passport, driver-license, utility-bill, gst, pan, etc.
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
}

// ========================================
// PROJECT MANAGEMENT MODELS
// ========================================

model Project {
  id              String        @id @default(cuid())
  projectId       String        @unique // e.g. P-2025-0001
  projectName     String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  siteName        String
  projectLocation String        @db.Text
  projectManager  String?
  status          ProjectStatus @default(ACTIVE)

  // Commission details
  commissionPersonName    String?
  commissionAmountPerM3   Float?
  commissionIncludeInCost Boolean @default(false)

  // Credit details
  creditAmount          Float?
  creditResetPeriodDays Int?

  projectProducts ProjectProduct[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)

  @@index([clientId])
}

model TempProject {
  id              String  @id @default(cuid())
  tempProjectId   String  @unique // e.g. TMP-1001
  projectName     String?
  clientId        String?
  siteName        String?
  projectLocation String? @db.Text

  // Commission details
  commissionPersonName    String?
  commissionAmountPerM3   Float?
  commissionIncludeInCost Boolean @default(false)

  // Credit details
  creditAmount          Float?
  creditResetPeriodDays Int?

  // Products stored as JSON temporarily
  productsData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Auto-expire after 24 hours
}

model ProjectProduct {
  id           String                 @id @default(cuid())
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productName  String
  productGrade String
  costPrice    Float
  vendors      ProjectProductVendor[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([projectId])
}

model ProjectProductVendor {
  id               String         @id @default(cuid())
  projectProductId String
  projectProduct   ProjectProduct @relation(fields: [projectProductId], references: [id], onDelete: Cascade)
  vendorId         String
  vendorName       String
  customPrice      Float
  priority         VendorPriority
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectProductId])
}

// ========================================
// ENUMS
// ========================================
enum MODE {
  EMAIL
  SMS
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  ACCOUNTANT
  FIELD_TECHNICIAN
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum VendorPriority {
  HIGH
  MEDIUM
  LOW
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum BillStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  LOST
}

enum Source {
  REFERRAL
  WEBSITE
  COLD_CALL
  ADVERTISEMENT
  SOCIAL_MEDIA
}

enum EntityType {
  LEAD
  POST
  PROJECT
  TASK
  USER
  CLIENT
}

enum ActivityAction {
  CREATED
  UPDATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  LOGGED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}
