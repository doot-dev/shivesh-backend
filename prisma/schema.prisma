// ========================================
// ENUMS
// ========================================
enum MODE {
  EMAIL
  SMS
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  ACCOUNTANT
  FIELD_TECHNICIAN
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum BillStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}
